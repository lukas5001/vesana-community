# Copy to .env and fill in real values. NEVER commit a real .env.

# Database (prod: existing shared Postgres + the "community" schema)
DATABASE_URL=postgresql+psycopg://community:community@localhost:5432/community

# Signs the admin session cookie. Use a long random value.
SECRET_KEY=change-me-to-a-long-random-secret

# Admin account (login page). The second factor (TOTP) is set up in the admin
# UI under Sicherheit and lives in the database (admin_accounts).
COMMUNITY_ADMIN_USER=admin
COMMUNITY_ADMIN_PASSWORD=change-me
# Admin session expires after this many minutes without activity.
COMMUNITY_ADMIN_IDLE_MINUTES=480
# Machine access to the admin JSON API (X-Admin-Authorization: Bearer <token>).
# Once 2FA is active this token is the ONLY way in for scripts; user+password
# in the header are refused then. Leave empty if no script needs the API.
COMMUNITY_ADMIN_API_TOKEN=

# Public base URL of this app
COMMUNITY_BASE_URL=http://localhost:8080
